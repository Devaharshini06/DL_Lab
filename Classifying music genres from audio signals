import os
import random
import numpy as np
import torch
import torch.nn as nn
import torchaudio
import torchaudio.transforms as T
from torch.utils.data import Dataset, DataLoader
from sklearn.metrics import f1_score, confusion_matrix, classification_report
from transformers import ASTFeatureExtractor, ASTForAudioClassification
import matplotlib.pyplot as plt
from tqdm import tqdm
print("imports done")
# =========================
# CONFIG
# =========================
DATA_PATH = "/kaggle/input/competitions/jan-2026-dl-gen-ai-project/messy_mashup/genres_stems"
GENRES = ["blues","classical","country","disco","hiphop",
          "jazz","metal","pop","reggae","rock"]
GENRE_TO_IDX = {g:i for i,g in enumerate(GENRES)}
SR = 16000
DURATION = 5
DEVICE = "cuda" if torch.cuda.is_available() else "cpu"
print(DEVICE)
# =========================
# DATASET
# =========================
class AudioDataset(Dataset):
    def __init__(self, root_dir):
        self.files = []
        for genre in GENRES:
            genre_path = os.path.join(root_dir, genre)
            for song in os.listdir(genre_path):
                self.files.append((os.path.join(genre_path, song), genre))
        random.shuffle(self.files)
        self.target_len = SR * DURATION
    def __len__(self):
        return len(self.files)
    def __getitem__(self, idx):
        path, genre = self.files[idx]
        label = GENRE_TO_IDX[genre]
        stems = ["drums.wav","vocals.wav","bass.wav","others.wav"]
        audio_sum = None
        for s in stems:
            fp = os.path.join(path, s)
            if os.path.exists(fp):
                audio, sr = torchaudio.load(fp)
                if audio.shape[0] > 1:
                    audio = audio.mean(dim=0, keepdim=True)
                if sr != SR:
                    audio = T.Resample(sr, SR)(audio)
                if audio_sum is None:
                    audio_sum = audio
                else:
                    min_len = min(audio_sum.shape[1], audio.shape[1])
                    audio_sum = audio_sum[:, :min_len] + audio[:, :min_len]
        waveform = audio_sum.squeeze(0)
        # Crop / Pad
        if waveform.shape[0] >= SR * DURATION:
            start = random.randint(0, waveform.shape[0] - SR * DURATION)
            waveform = waveform[start:start + SR * DURATION]
        else:
            waveform = torch.nn.functional.pad(waveform, (0, SR * DURATION - waveform.shape[0]))
        # Normalize
        waveform = (waveform - waveform.mean()) / (waveform.std() + 1e-6)
        return waveform.numpy(), label
print("dataset initialized")
# =========================
# DATALOADER
# =========================
dataset = AudioDataset(DATA_PATH)
train_size = int(0.8 * len(dataset))
val_size = len(dataset) - train_size
train_ds, val_ds = torch.utils.data.random_split(dataset, [train_size, val_size])
def collate_fn(batch):
    waves, labels = zip(*batch)
    return list(waves), torch.tensor(labels)
train_loader = DataLoader(train_ds, batch_size=8, shuffle=True, collate_fn=collate_fn)
val_loader = DataLoader(val_ds, batch_size=8, shuffle=False, collate_fn=collate_fn)
print("Train:", len(train_ds), "Val:", len(val_ds))
# =========================
# MODEL
# =========================
feature_extractor = ASTFeatureExtractor.from_pretrained(
    "MIT/ast-finetuned-audioset-10-10-0.4593"
)
model = ASTForAudioClassification.from_pretrained(
    "MIT/ast-finetuned-audioset-10-10-0.4593",
    num_labels=10,
    ignore_mismatched_sizes=True
).to(DEVICE)
# =========================
# TRAINING SETUP
# =========================
optimizer = torch.optim.AdamW(model.parameters(), lr=5e-5)
criterion = nn.CrossEntropyLoss()
EPOCHS = 5
# =========================
# TRAINING LOOP
# =========================
best_f1 = 0
for epoch in range(EPOCHS):
    model.train()
    total_loss = 0
    for waves, labels in tqdm(train_loader, desc=f"Epoch {epoch+1}"):
        inputs = feature_extractor(
            waves,
            sampling_rate=16000,
            return_tensors="pt",
            padding=True
        )
        input_values = inputs["input_values"].to(DEVICE)
        labels = labels.to(DEVICE)
        outputs = model(input_values=input_values)
        loss = criterion(outputs.logits, labels)
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
        total_loss += loss.item()
    # VALIDATION
    model.eval()
    preds, targets = [], []
    with torch.no_grad():
        for waves, labels in val_loader:
            inputs = feature_extractor(
                waves,
                sampling_rate=16000,
                return_tensors="pt",
                padding=True
            )
            outputs = model(input_values=inputs["input_values"].to(DEVICE))
            pred = outputs.logits.argmax(dim=1).cpu().numpy()
            preds.extend(pred)
            targets.extend(labels.numpy())
    f1 = f1_score(targets, preds, average="macro")
    print(f"\nEpoch {epoch+1} | Loss {total_loss/len(train_loader):.4f} | Val F1 {f1:.4f}")
    if f1 > best_f1:
        best_f1 = f1
        torch.save(model.state_dict(), "best_ast.pt")
print("\nBest Validation F1:", best_f1)
# =========================
# FINAL EVALUATION
# =========================
model.load_state_dict(torch.load("best_ast.pt"))
model.eval()
preds, targets = [], []
with torch.no_grad():
    for waves, labels in val_loader:
        inputs = feature_extractor(
            waves,
            sampling_rate=16000,
            return_tensors="pt",
            padding=True
        )
        outputs = model(input_values=inputs["input_values"].to(DEVICE))
        pred = outputs.logits.argmax(dim=1).cpu().numpy()
        preds.extend(pred)
        targets.extend(labels.numpy())
# =========================
# RESULTS
# =========================
print("\nFinal F1 Score:", f1_score(targets, preds, average="macro"))
print("\nClassification Report:\n")
print(classification_report(targets, preds))
cm = confusion_matrix(targets, preds)
plt.figure(figsize=(8,6))
plt.imshow(cm, cmap='Blues')
plt.title("Confusion Matrix")
plt.colorbar()
plt.show()
